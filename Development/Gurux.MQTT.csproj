<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net11.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(BuildMobile)' == 'true'">net11.0;net10.0;net11.0-windows10.0.19041.0;net10.0-windows10.0.19041.0;net11.0-android;net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(BuildApple)' == 'true'">net11.0;net10.0;net11.0-windows10.0.19041.0;net10.0-windows10.0.19041.0;net11.0-android;net10.0-android;net11.0-ios;net10.0-ios</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <RootNamespace>Gurux.MQTT</RootNamespace>
        <AssemblyName>Gurux.MQTT</AssemblyName>
        <Company>Gurux Ltd</Company>
        <Authors>Gurux Ltd</Authors>
        <Copyright>Copyright (c) 1998-2026 Gurux Ltd. All rights reserved.</Copyright>
        <PackageProjectUrl>https://www.gurux.fi/GXMQTT</PackageProjectUrl>
        <Description>Cross-platform asynchronous MQTT media for Gurux bridges.</Description>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' == '' ">0.0.1-local</Version>
        <Version Condition=" '$(BUILD_BUILDNUMBER)' != '' ">$(BUILD_BUILDNUMBER)</Version>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <RepositoryUrl>https://github.com/gurux/gurux.mqtt</RepositoryUrl>
        <PackageTags>Gurux Device Framework MQTT</PackageTags>
        <PackageId>Gurux.MQTT</PackageId>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
        <PackageIcon>gurux_mqtt.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.*</GuruxCommonVersion>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="GXMqtt.cs;GXMqtt.Settings.cs;MqttSettings.cs;MqttJsonContext.cs;AvailableMediaSettings.cs;Message/GXMessage.cs;Message/MessageType.cs;Properties/Resources.cs" />
        <EmbeddedResource Include="Properties/Resources.resx" />
        <None Include="gurux_mqtt.png" Pack="true" PackagePath="/" />
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
        <None Include="../LICENSES/LicenseRef-Gurux-Commercial" Pack="true" PackagePath="LICENSES/" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Gurux.Common" Version="9.0.2611.1601" />
        <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    </ItemGroup>
</Project>
